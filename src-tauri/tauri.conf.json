{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Vending Machine Dispenser",
  "version": "1.0.0",
  "identifier": "com.vendingmachine.app",
  "build": {
    "frontendDist": "..",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vending Machine Dispenser",
        "width": 1080,
        "height": 1920,
        "fullscreen": false,
        "resizable": false,
        "decorations": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Vending Machine",
    "copyright": "Copyright © 2026",
    "category": "Game",
    "shortDescription": "Interactive Vending Machine Game",
    "longDescription": "A fun interactive vending machine game where players catch falling objects",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {}
}
