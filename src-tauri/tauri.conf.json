{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Vending Machine Dispenser",
  "version": "1.0.0",
  "identifier": "com.vendingmachine.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Vending Machine Dispenser",
        "width": 1920,
        "height": 1080,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "center": true,
        "fileDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    }
  },
  "plugins": {}
}
